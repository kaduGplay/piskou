# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel (produção).
# Nunca coloque estas chaves no código nem em variáveis VITE_ (essas vão para o navegador).

# mock = modo de teste (nada é cobrado; bloqueado em produção); liberpay = SPEI/OXXO em pesos (MXN)
PAYMENT_GATEWAY=liberpay
LIBERPAY_CLIENT_ID=
LIBERPAY_CLIENT_SECRET=
# Segredo longo e aleatório; o webhook é cadastrado na LiberPay como <SITE_URL>/api/webhook?key=<este valor>.
LIBERPAY_WEBHOOK_SECRET=
# Regiões da Vercel com IP fixo liberado na LiberPay (padrão iad1). Fora delas a LiberPay nunca é chamada.
LIBERPAY_STATIC_REGIONS=iad1

# Meta: Pixel e token da API de Conversões (compra confirmada enviada pelo servidor).
META_PIXEL_ID=1429884866005189
META_ACCESS_TOKEN=

# Endereço público do site, usado no checkout_url/shop_url da LiberPay. Ex.: https://piskoumx.vercel.app
SITE_URL=

# Supabase: URL do projeto e chave SECRETA, apenas no servidor (nunca VITE_).
# Aplique supabase/migrations/202610100001_payment_store.sql no banco.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternativa à SUPABASE_SECRET_KEY: chave service_role legada.
SUPABASE_SERVICE_ROLE_KEY=

# Alternativa ao Supabase: Upstash Redis. Se ambos existirem, Supabase tem prioridade.
# Localmente não precisa: o status das cobranças fica em memória.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Apenas no servidor: respostas de IA para as 7 mensagens gratuitas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHAT_SESSION_SECRET=

# Senha do painel /admin. Apenas no servidor; use uma senha longa e exclusiva.
ADMIN_PASSWORD=

# Apenas servidor. Uma única janela após o último envio, limitada a 3 s pelo banco.
CHAT_GROUP_WINDOW_MS=1500
CHAT_TIME_ZONE=America/Sao_Paulo
# Mesmo segredo configurado no Vault para o worker (supabase/setup/chat-worker.sql).
CHAT_WORKER_SECRET=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
