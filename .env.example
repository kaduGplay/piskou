# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel (produção).
# Nunca coloque estas chaves no código nem em variáveis VITE_ (essas vão para o navegador).

# mock = modo de teste (nada é cobrado; bloqueado em produção); voidpay = Void Payments
PAYMENT_GATEWAY=voidpay
VOIDPAY_PUBLIC_KEY=
VOIDPAY_SECRET_KEY=

# Enviados em todas as cobranças, porque o checkout não pede CPF nem telefone ao cliente.
# A Void exige o telefone; sem VOIDPAY_FIXED_PHONE as cobranças são recusadas.
VOIDPAY_FIXED_PHONE=
VOIDPAY_FIXED_DOCUMENT=

# Endereço público do site, usado no aviso de pagamento (webhook). Ex.: https://create.piskou.com
SITE_URL=

# Supabase: URL do projeto e chave SECRETA, apenas no servidor (nunca VITE_).
# Aplique supabase/migrations/202610100001_payment_store.sql no banco.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternativa à SUPABASE_SECRET_KEY: chave service_role legada.
SUPABASE_SERVICE_ROLE_KEY=

# Alternativa ao Supabase: Upstash Redis. Se ambos existirem, Supabase tem prioridade.
# Localmente não precisa: o status das cobranças fica em memória.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Apenas no servidor: respostas de IA para a prévia de 3 mensagens.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHAT_SESSION_SECRET=
